# Copy to .env.local and fill in. Never commit real values.

# Public by design (protected by RLS). The server passes them to the browser.
# The NEXT_PUBLIC_ prefixed names are also accepted.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only secret. Used by the server ONLY to deliver push notifications to
# other members' devices (and by E2E tests). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Web Push (server-only except the public key, which the server passes to the browser)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: run E2E tests against a deployed URL instead of a local server
# E2E_BASE_URL=https://dogcare-gamma.vercel.app
