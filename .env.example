# Copy to .env.local and fill in. Never commit real values.

# Public (exposed to the browser by design, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy name also accepted by the app:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — ONLY for automated end-to-end tests on your machine.
# The app itself never uses it. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: run E2E tests against a deployed URL instead of a local server
# E2E_BASE_URL=https://dogcare-mu.vercel.app

# Phase 2 (Web Push) — not used yet
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
