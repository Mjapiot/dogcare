# Copy to .env.local and fill in. Never commit real values.

# Public by design (protected by RLS). The server passes them to the browser.
# The NEXT_PUBLIC_ prefixed names are also accepted.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only — ONLY for automated end-to-end tests on your machine.
# The app itself never uses it. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: run E2E tests against a deployed URL instead of a local server
# E2E_BASE_URL=https://dogcare-gamma.vercel.app

# Phase 2 (Web Push) — not used yet
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
